# MongoDB connection string (Atlas or local replica set)
MONGODB_URI=mongodb://127.0.0.1:27017/clinic-scheduler?replicaSet=rs0

# Auth.js secret — generate with: npx auth secret
AUTH_SECRET=replace-with-a-long-random-secret

# Public app URL (set to your Vercel URL in production)
AUTH_URL=http://localhost:3000

# Clinic timezone for shift date/time normalization
CLINIC_TIMEZONE=America/Toronto

# Optional: set to true in local dev behind proxies / on Vercel
AUTH_TRUST_HOST=true
