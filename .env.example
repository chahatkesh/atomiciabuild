# MongoDB Atlas connection string (you will add the real URL)
MONGODB_URI=mongodb://127.0.0.1:27017/clinic-scheduler?replicaSet=rs0

# Auth.js secret — generate with: npx auth secret
AUTH_SECRET=replace-with-a-long-random-secret

# Public app URL (Vercel sets this automatically in production)
AUTH_URL=http://localhost:3000

# Clinic timezone for shift date/time normalization
CLINIC_TIMEZONE=America/Toronto

# Optional: set to true in local dev behind proxies
AUTH_TRUST_HOST=true
